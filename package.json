{
  "name": "markify",
  "displayName": "Markify",
  "description": "Save tokens with markdown",
  "version": "0.1.1",
  "publisher": "MCCProgrammer",
  "author": {
    "name": "MCCProgrammer",
    "email": "contact@mccprogrammer.com"
  },
  "sponsor": {
    "url": "https://ko-fi.com/mccprogrammer"
  },
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MCCProgrammer/markitdown-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/MCCProgrammer/markitdown-vscode-extension/issues"
  },
  "homepage": "https://github.com/MCCProgrammer/markitdown-vscode-extension#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters",
    "Data Science"
  ],
  "keywords": [
    "markdown",
    "markitdown",
    "pdf to markdown",
    "docx to markdown",
    "ai",
    "llm",
    "tokens",
    "converter",
    "document",
    "openai",
    "context",
    "rag"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markitdown.openPanel",
        "title": "Markify: Open Converter Panel"
      },
      {
        "command": "markitdown.convertFile",
        "title": "Markify: Convert to Markdown"
      },
      {
        "command": "markitdown.checkSetup",
        "title": "Markify: Check Setup (Python & MarkItDown)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "markitdown.convertFile",
          "when": "resourceExtname =~ /\\.(pdf|docx|doc|xlsx|xls|pptx|ppt|html|htm|csv|json|xml|epub|msg|zip|jpg|jpeg|png|mp3|wav)$/i",
          "group": "7_modification"
        }
      ],
      "editor/title/context": [
        {
          "command": "markitdown.convertFile",
          "when": "resourceExtname =~ /\\.(pdf|docx|doc|xlsx|xls|pptx|ppt|html|htm|csv|json|xml|epub|msg|zip)$/i",
          "group": "1_run"
        }
      ]
    },
    "configuration": {
      "title": "Markify",
      "properties": {
        "markitdown.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python executable. Leave empty to auto-detect (tries python3, Homebrew, python3.12, python3.11, etc.)."
        },
        "markitdown.outputMode": {
          "type": "string",
          "enum": [
            "sameFolder",
            "openInEditor",
            "ask"
          ],
          "default": "sameFolder",
          "description": "Where to save converted Markdown: next to the original file, open in a new tab, or ask every time."
        },
        "markitdown.showTokenStats": {
          "type": "boolean",
          "default": true,
          "description": "Show token count and savings vs. the raw file after each conversion."
        },
        "markitdown.panelColumn": {
          "type": "string",
          "enum": [
            "beside",
            "active"
          ],
          "enumDescriptions": [
            "Open the converter panel beside the current editor (column two)",
            "Open the converter panel in the same column as the current editor"
          ],
          "default": "beside",
          "description": "Where to open the Markify converter panel."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "gpt-tokenizer": "^2.4.0"
  }
}
